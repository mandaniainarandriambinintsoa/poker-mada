# Server
PORT=3001
NODE_ENV=development
ENABLE_TEST_BOTS=false
ALLOW_LOCAL_REGISTRATION=true

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/poker_mada?schema=public&connection_limit=10&pool_timeout=10"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ISSUER=poker-mada-api
JWT_AUDIENCE=poker-mada-web
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Identity Services
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
SESSION_COOKIE_SAME_SITE=lax
# SESSION_COOKIE_DOMAIN=.example.com

# Mobile Money - Orange Money
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/mg/v1
ORANGE_MONEY_MERCHANT_ID=your-merchant-id
ORANGE_MONEY_API_KEY=your-api-key

# Mobile Money - MVola
MVOLA_API_URL=https://devapi.mvola.mg
MVOLA_CONSUMER_KEY=your-consumer-key
MVOLA_CONSUMER_SECRET=your-consumer-secret
MVOLA_MERCHANT_NUMBER=0340000000

# Mobile Money - Airtel Money
AIRTEL_MONEY_API_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=your-client-id
AIRTEL_MONEY_CLIENT_SECRET=your-client-secret
